# Quokka как служба на VPS. Установка: см. раздел про VPS в README.
#
# Адрес VPS задаётся в /etc/default/quokka:
#   QUOKKA_PUBLIC=vps.example.com

[Unit]
Description=Quokka mesh node
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/quokka
Environment=QUOKKA_HOME=/var/lib/quokka
ExecStart=/opt/quokka/quokka server --public ${QUOKKA_PUBLIC}
Restart=always
RestartSec=3

User=quokka
StateDirectory=quokka
StateDirectoryMode=0700
UMask=0077

# Узлу нужны только сеть и своя папка
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
